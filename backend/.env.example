# Core Application Settings
ENVIRONMENT=development
PORT=4100
DEBUG=False
SECRET_KEY=replace_with_at_least_32_random_characters
ALLOWED_HOSTS=["localhost"]

# Database Settings
MONGO_URL=mongodb://localhost:27017
DB_NAME=shiancochat_db

# LLM API Settings
# Example: http://localhost:1234 for LM Studio, or your OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:1234

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# Web Search Settings
# Comma-separated list of enabled engines: duckduckgo, brave, sougou, bing
WEB_SEARCH_ENGINES=duckduckgo,brave
# Required if using Brave Search
BRAVE_API_KEY=
# Required if using Sougou Search
SOUGOU_API_SID=
SOUGOU_API_SK=
# Required if using Bing Search
BING_API_KEY=

# Proxy Settings (optional)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# RAG / Vector Search Settings
# Embedding model: all-MiniLM-L6-v2 (default) or bge-m3 for better multilingual performance
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_MODEL_PATH=/path/to/custom/model  # Optional: override model directory

# MongoDB Atlas Vector Search (requires Atlas cluster with vector index)
# Set to true to enable Atlas Vector Search instead of in-memory numpy similarity
VECTOR_SEARCH_ENABLED=false
VECTOR_SEARCH_INDEX=vector_index

# Hybrid Search: combines vector similarity + full-text search
# Requires text index on document_chunks.content (auto-created on startup)
HYBRID_SEARCH_ENABLED=false
HYBRID_SEARCH_ALPHA=0.7

# RAG Quality Tuning
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=5
RAG_MMR_LAMBDA=0.7
